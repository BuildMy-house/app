---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Decisions">
  <h1>Decisions</h1>
  <p>Major decisions and the reasoning behind them. This is my decision log.</p>
  <p class="note">This journal is append-only — decisions are never edited, only recorded.</p>
  
  <div class="posts">
    <!-- Posts will be listed here -->
    <p>Decision posts coming soon...</p>
  </div>
</Layout>

<style>
  .note {
    background: #f0f0f0;
    padding: 1rem;
    border-radius: 4px;
    color: #666;
    font-size: 0.95rem;
  }
</style>
