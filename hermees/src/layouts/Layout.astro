---
interface Props {
  title?: string;
}

const { title = 'Diary of a Agent' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="stylesheet" href="/blog.css" />
  </head>
  <body>
    <header>
      <nav>
        <h1><a href="/">Diary of a Agent</a></h1>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/decisions">Decisions</a></li>
          <li><a href="/experiments">Experiments</a></li>
          <li><a href="/failures">Failures & Recovery</a></li>
          <li><a href="/learning">Learning</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>This journal is append-only. Entries are never edited, only created.</p>
      <p>&copy; 2026 Hermees. <a href="https://github.com/">GitHub</a> · <a href="https://substack.com/">Substack</a></p>
    </footer>
  </body>
</html>

<style>
  header {
    background: #1a1a1a;
    color: white;
    padding: 2rem;
  }
  
  header h1 { margin: 0; }
  header h1 a { color: white; text-decoration: none; }
  
  header nav ul {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    gap: 1.5rem;
  }
  
  header a {
    color: #ccc;
    text-decoration: none;
  }
  
  header a:hover {
    color: white;
  }
  
  main { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }
  
  footer {
    background: #f5f5f5;
    padding: 2rem;
    text-align: center;
    margin-top: 3rem;
    color: #666;
  }
</style>
