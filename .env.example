# =============================================================================
# buildmyhouse / Homely — Environment Variables
# =============================================================================
#
# Two deployment modes exist. Pick the section that matches your setup.
# Full architecture details: see DEPLOYMENT_MODES.md

# -----------------------------------------------------------------------------
# CORS (server) — cross-origin API access
# -----------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API cross-origin
# (credentials included). Takes priority over the built-in defaults.
# Unset + NODE_ENV !== production: http://localhost:5173 and http://localhost:3000
# are allowed for developer convenience.
# Unset + NODE_ENV === production: NO cross-origin requests (same-origin only —
# the single-container deployment serves its own frontend).

# CORS_ALLOWED_ORIGINS=https://myhouse.example.com,https://staging.example.com

# -----------------------------------------------------------------------------
# LOCAL MODE — local development or self-hosted single-instance
# -----------------------------------------------------------------------------
# Standalone deployments may provide an Infisical Universal Auth identity. The
# container fetches secrets at startup; never commit the client secret.
# INFISICAL_HOST_URL=https://eu.infisical.com
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=dev
# INFISICAL_SECRET_PATH=/

# SQLite is used by default when DATABASE_URL is not set.
# Axiom telemetry is a no-op if VITE_AXIOM_TOKEN is left empty.
# No DATABASE_URL needed — the app creates a local SQLite file automatically.

# -----------------------------------------------------------------------------
# QUOTAS (per-user) — optional, sensible defaults if unset
# -----------------------------------------------------------------------------
# MAX_TOTAL_ASSET_BYTES_PER_USER: max combined asset bytes (glb + source)
# stored per user. Uploads that would exceed it are rejected with 413.
# Default: 1073741824 (1 GiB).
# MAX_HOMES_PER_USER: max homes one user may own (personal + team homes they
# created). Home creation beyond it is rejected with 400.
# Default: 500.

MAX_TOTAL_ASSET_BYTES_PER_USER=1073741824
MAX_HOMES_PER_USER=500

# Internal LuxCore worker authentication. Generate with:
# openssl rand -hex 32
LUXCORE_WORKER_TOKEN=

# No code-side fallback for VITE_AXIOM_ENDPOINT: Axiom datasets can be pinned
# to a specific regional edge domain (ingest against the wrong domain fails),
# so all three of these must be set here (or in Infisical) — never guessed.
VITE_AXIOM_TOKEN=
VITE_AXIOM_DATASET=buildmy-house-telemetry
VITE_AXIOM_ENDPOINT=https://eu-central-1.aws.edge.axiom.co

# -----------------------------------------------------------------------------
# FEATURE FLAGS (build-time, Vite) — optional
# -----------------------------------------------------------------------------
# VITE_ENABLE_MULTI_LEVEL gates the multi-level/multi-floor UI (add level,
# level switcher, delete level). Unset or any value other than the literal
# string "true" disables it: single-level homes get no level buttons at all,
# and homes already saved with multiple levels keep read-only navigation
# (switch between levels, rename) but no add/delete controls. Set to "true"
# to enable. Default: unset (disabled) — multi-level support is still being
# hardened.

# VITE_ENABLE_MULTI_LEVEL=true

# -----------------------------------------------------------------------------
# SERVER ERROR REPORTING (Axiom) — optional
# -----------------------------------------------------------------------------
# Server-side errors (centralized error handler + process-level crashes) are
# POSTed to Axiom's ingest API, mirroring the frontend telemetry transport.
# Complete no-op if AXIOM_TOKEN or AXIOM_ENDPOINT is unset — no code-side
# fallback here either, for the same edge-domain reason as above.
# NOTE: this is a DIFFERENT secret from VITE_AXIOM_TOKEN — that one is bundled
# into client-side JS (already public). Never reuse it server-side.
# Shares the same 'buildmy-house-telemetry' dataset as client telemetry by
# default — one flexible dataset for all app telemetry, not a separate one
# per source.

# AXIOM_TOKEN=
# AXIOM_DATASET=buildmy-house-telemetry
# AXIOM_ENDPOINT=https://eu-central-1.aws.edge.axiom.co

# -----------------------------------------------------------------------------
# EMAIL (password reset + magic-link login) — optional
# -----------------------------------------------------------------------------
# Without RESEND_API_KEY, emails are not sent; full content (including login/
# reset links) is logged to the server console with an [email:dev-fallback]
# prefix, so all email features still work locally.
# Set RESEND_FROM_EMAIL together with RESEND_API_KEY (required when the key is set).
# APP_BASE_URL is used to build links embedded in emails; defaults to http://localhost:3000.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MCP — local stdio and authenticated streamable HTTP
# Local test identity (ignored .env, not committed):
# BUILDMYHOUSE_MCP_USER=test
# BUILDMYHOUSE_MCP_TOKEN=replace-with-local-test-token
# For production, prefer a token:user JSON map:
# BUILDMYHOUSE_MCP_TOKENS_JSON={"token-for-alice":"alice","token-for-bob":"bob"}
# BUILDMYHOUSE_MCP_RESOURCE_URL=https://your-host.example/mcp
# BUILDMYHOUSE_MCP_ISSUER_URL=https://your-host.example/mcp

# -----------------------------------------------------------------------------
# WEBSERVER MODE — cloud-hosted / multi-instance with Neon PostgreSQL
# -----------------------------------------------------------------------------
# Requires a Neon (or compatible) PostgreSQL connection string.
# Axiom telemetry is required for webserver deployments.

# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# VITE_AXIOM_TOKEN=<your-axiom-token>
# VITE_AXIOM_DATASET=homely-telemetry
# VITE_AXIOM_ENDPOINT=https://api.axiom.co
