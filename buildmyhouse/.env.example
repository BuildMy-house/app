# =============================================================================
# buildmyhouse / Homely — Environment Variables
# =============================================================================
#
# Two deployment modes exist. Pick the section that matches your setup.
# Full architecture details: see DEPLOYMENT_MODES.md

# -----------------------------------------------------------------------------
# CORS (server) — cross-origin API access
# -----------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API cross-origin
# (credentials included). Takes priority over the built-in defaults.
# Unset + NODE_ENV !== production: http://localhost:5173 and http://localhost:3000
# are allowed for developer convenience.
# Unset + NODE_ENV === production: NO cross-origin requests (same-origin only —
# the single-container deployment serves its own frontend).

# CORS_ALLOWED_ORIGINS=https://myhouse.example.com,https://staging.example.com

# -----------------------------------------------------------------------------
# LOCAL MODE — local development or self-hosted single-instance
# -----------------------------------------------------------------------------
# SQLite is used by default when DATABASE_URL is not set.
# Axiom telemetry is a no-op if VITE_AXIOM_TOKEN is left empty.
# No DATABASE_URL needed — the app creates a local SQLite file automatically.

# -----------------------------------------------------------------------------
# QUOTAS (per-user) — optional, sensible defaults if unset
# -----------------------------------------------------------------------------
# MAX_TOTAL_ASSET_BYTES_PER_USER: max combined asset bytes (glb + source)
# stored per user. Uploads that would exceed it are rejected with 413.
# Default: 1073741824 (1 GiB).
# MAX_HOMES_PER_USER: max homes one user may own (personal + team homes they
# created). Home creation beyond it is rejected with 400.
# Default: 500.

MAX_TOTAL_ASSET_BYTES_PER_USER=1073741824
MAX_HOMES_PER_USER=500

VITE_AXIOM_TOKEN=
VITE_AXIOM_DATASET=homely-telemetry
VITE_AXIOM_ENDPOINT=https://api.axiom.co

# -----------------------------------------------------------------------------
# EMAIL (password reset + magic-link login) — optional
# -----------------------------------------------------------------------------
# Without RESEND_API_KEY, emails are not sent; full content (including login/
# reset links) is logged to the server console with an [email:dev-fallback]
# prefix, so all email features still work locally.
# Set RESEND_FROM_EMAIL together with RESEND_API_KEY (required when the key is set).
# APP_BASE_URL is used to build links embedded in emails; defaults to http://localhost:3000.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WEBSERVER MODE — cloud-hosted / multi-instance with Neon PostgreSQL
# -----------------------------------------------------------------------------
# Requires a Neon (or compatible) PostgreSQL connection string.
# Axiom telemetry is required for webserver deployments.

# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# VITE_AXIOM_TOKEN=<your-axiom-token>
# VITE_AXIOM_DATASET=homely-telemetry
# VITE_AXIOM_ENDPOINT=https://api.axiom.co
