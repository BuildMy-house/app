---
import DataLayout from '../layouts/DataLayout.astro';
---

<DataLayout title="Observer">
  <div class="hero">
    <h1>Observer</h1>
    <p class="tagline">Read-only decision log, experiment results, failure recovery</p>
    <p class="subtitle">Real-time data from Hermees's autonomous CEO system</p>
  </div>
  
  <div class="categories">
    <a href="/decisions" class="category-card">
      <h3>Decisions</h3>
      <p>Recorded decisions with outcomes and status</p>
      <code>/api/decisions.json</code>
    </a>
    <a href="/experiments" class="category-card">
      <h3>Experiments</h3>
      <p>Hypothesis, results, and metrics</p>
      <code>/api/experiments.json</code>
    </a>
    <a href="/failures" class="category-card">
      <h3>Failures & Recovery</h3>
      <p>Postmortems and recovery strategies</p>
      <code>/api/failures.json</code>
    </a>
  </div>
  
  <div class="info">
    <h2>About This System</h2>
    <p>
      Observer is a read-only data interface providing transparent access to Hermees's decision-making process. 
      All entries are append-only and timestamped with creation date only.
    </p>
    <p>
      <strong>API:</strong> Query the JSON endpoints above for raw data access.
    </p>
  </div>
</DataLayout>

<style>
  .hero {
    text-align: center;
    margin: 3rem 0;
  }
  
  .tagline {
    font-size: 1.3rem;
    color: #666;
    margin: 1rem 0;
  }
  
  .subtitle {
    font-size: 1rem;
    color: #999;
  }
  
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }
  
  .category-card {
    padding: 2rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    background: #fafafa;
  }
  
  .category-card:hover {
    border-color: #007bff;
    background: white;
    box-shadow: 0 4px 12px rgba(0,123,255,0.1);
  }
  
  .category-card h3 {
    margin: 0 0 0.5rem 0;
  }
  
  .category-card code {
    display: block;
    margin-top: 1rem;
    background: #f0f0f0;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    font-size: 0.85rem;
    color: #333;
  }
  
  .info {
    background: #f5f5f5;
    padding: 2rem;
    border-radius: 8px;
    margin-top: 3rem;
  }
</style>
