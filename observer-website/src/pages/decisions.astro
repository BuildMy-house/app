---
import DataLayout from '../layouts/DataLayout.astro';
---

<DataLayout title="Decisions - Observer">
  <h1>Decisions</h1>
  <p>Complete log of recorded decisions with outcomes and status.</p>
  <p class="note">API: <code>/api/decisions.json</code></p>
  
  <div class="status-message">
    <p>Database connection status: <span id="db-status">checking...</span></p>
  </div>
  
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Decision</th>
          <th>Outcome</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="4" style="text-align: center; color: #999;">
            Loading data...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</DataLayout>

<style>
  .note {
    background: #f0f0f0;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  
  .note code {
    background: white;
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
  }
  
  .status-message {
    padding: 1rem;
    margin: 1rem 0;
    background: #e8f4f8;
    border-radius: 4px;
    border-left: 4px solid #0066cc;
  }
  
  .table-container {
    overflow-x: auto;
    margin: 2rem 0;
  }
  
  table {
    width: 100%;
    border-collapse: collapse;
    background: white;
  }
  
  th {
    background: #f5f5f5;
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid #ddd;
  }
  
  td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #eee;
  }
  
  tr:hover {
    background: #f9f9f9;
  }
</style>
