# Axiom telemetry (see src/telemetry/config.ts). Client-side ingest token —
# this is a write-only Axiom API token scoped to ingest only, safe to embed
# in the built app (never use a token with read/query/admin scope here).
# Query access for debugging lives separately in company-ops/.env (AXIOM_TOKEN,
# used by `company-ops telemetry-query` — a different, read-scoped token).
VITE_AXIOM_TOKEN=
VITE_AXIOM_DATASET=homely-telemetry
VITE_AXIOM_ENDPOINT=https://api.axiom.co
