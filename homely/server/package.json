{
  "name": "homely-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Homely backend: auth API (Express + better-sqlite3 + JWT). Independent package, not part of the Vite app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
