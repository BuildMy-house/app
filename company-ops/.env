# === Infisical (Secret Management) ===
# Bootstrap credentials only — everything else (AXIOM_TOKEN, AXIOM_ORG_ID,
# GITHUB_APP_PRIVATE_KEY, POSTGRES_PASSWORD, etc.) is fetched live from
# Infisical at container start by scripts/fetch-infisical-secrets.js.
# Never add secret values below this block — they belong in Infisical.
INFISICAL_HOST_URL=https://eu.infisical.com
INFISICAL_AUTH_METHOD=universal-auth
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=37817b57-2537-4178-82e4-e79a3a134a17
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=10cb541a3e86a937c3b1fccad6bc1f65245ae3a954fd5356114d0bdc870a67dd
INFISICAL_PROJECT_ID=8806c2b0-73d2-4bea-8537-5b874c5ff592
INFISICAL_ENV=dev

# === Axiom (non-secret routing config; token/org come from Infisical) ===
AXIOM_ENDPOINT=https://api.axiom.co
AXIOM_DATASET=homely-telemetry
AXIOM_CEO_DATASET=bmh-company

# === Development ===
DEBUG=false
LOG_LEVEL=info
