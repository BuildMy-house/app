---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Design with intention">
  <section class="hero">
    <span class="eyebrow">A better blueprint for living</span>
    <h1>Make room for <em>good ideas.</em></h1>
    <div class="hero-copy">
      <p>House Designer turns early sketches into clear, considered spaces. Explore the shape of a home before a single wall goes up.</p>
      <div><a class="button" href="/contact">Build your first plan ↗</a></div>
    </div>
    <div class="orb" aria-hidden="true"></div>
  </section>
  <section class="cards" aria-label="Product highlights">
    <article class="card"><span class="number">01 / DRAW</span><h3>Think in plans</h3><p>Sketch walls, rooms, and relationships without getting lost in the details.</p></article>
    <article class="card"><span class="number">02 / SEE</span><h3>Walk it through</h3><p>Move from a flat plan to a living, light-filled view of what comes next.</p></article>
    <article class="card"><span class="number">03 / SHARE</span><h3>Make it legible</h3><p>Give collaborators a shared picture of the space and the decisions inside it.</p></article>
  </section>
</Layout>
